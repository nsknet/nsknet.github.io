<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%232563eb' stroke-width='2'><rect x='2' y='2' width='20' height='8' rx='2'/><rect x='2' y='14' width='20' height='8' rx='2'/></svg>" />
    <style>
        :root {
            --bg: #f4f6f9;
            --surface: #ffffff;
            --surface-2: #f8fafc;
            --border: #e4e7ec;
            --text: #0f172a;
            --muted: #64748b;
            --accent: #2563eb;
            --ok: #16a34a;
            --info: #0284c7;
            --warn: #d97706;
            --crit: #dc2626;
            --track: #e9edf2;
            --shadow: 0 1px 2px rgba(15, 23, 42, .04), 0 4px 16px rgba(15, 23, 42, .05);
            --radius: 14px;
            --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
        }
        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #0b0f17;
                --surface: #121826;
                --surface-2: #0f1520;
                --border: #232c3d;
                --text: #e6e9ef;
                --muted: #8b95a7;
                --accent: #60a5fa;
                --ok: #22c55e;
                --info: #38bdf8;
                --warn: #f59e0b;
                --crit: #f87171;
                --track: #1e2636;
                --shadow: 0 1px 2px rgba(0, 0, 0, .3);
            }
        }

        * { box-sizing: border-box; }
        html { -webkit-text-size-adjust: 100%; }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        a { color: var(--accent); text-decoration: none; }
        a:hover { text-decoration: underline; }
        code, .mono { font-family: var(--mono); font-size: 12.5px; }
        .ic { flex: none; vertical-align: -3px; }

        .wrap { max-width: 1240px; margin: 0 auto; padding: 24px 16px 48px; }

        /* Header */
        .top { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; margin-bottom: 20px; }
        .brand { display: flex; gap: 12px; align-items: center; min-width: 0; }
        .logo { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, #2563eb, #7c3aed); flex: none; }
        .brand h1 { margin: 0; font-size: 20px; line-height: 1.2; overflow-wrap: anywhere; }
        .brand p { margin: 2px 0 0; color: var(--muted); font-size: 13px; }
        .actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .btn { display: inline-flex; gap: 6px; align-items: center; height: 34px; padding: 0 12px; border-radius: 9px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font: inherit; font-weight: 500; cursor: pointer; }
        .btn:hover { border-color: var(--accent); text-decoration: none; }
        .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
        .toggle { display: inline-flex; gap: 6px; align-items: center; color: var(--muted); font-size: 13px; cursor: pointer; user-select: none; }

        /* Cards */
        .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px; min-width: 0; }
        .card-h { display: flex; align-items: center; gap: 8px; margin: 0 0 14px; font-size: 14px; font-weight: 600; }
        .card-h .ic { color: var(--accent); }
        .card-h .sub { margin-left: auto; color: var(--muted); font-weight: 400; font-size: 12px; }
        .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); margin-top: 16px; }
        .span-2 { grid-column: span 2; }
        .span-all { grid-column: 1 / -1; }
        @@media (max-width: 760px) { .span-2 { grid-column: auto; } .grid { grid-template-columns: 1fr; } }

        /* Status banner */
        .banner { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 20px; align-items: center; }
        .score { --c: var(--ok); width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center;
                 background: conic-gradient(var(--c) calc(var(--p) * 1%), var(--track) 0); }
        .score > div { width: 76px; height: 76px; border-radius: 50%; background: var(--surface); display: grid; place-items: center; text-align: center; }
        .score b { font-size: 26px; line-height: 1; }
        .score small { display: block; color: var(--muted); font-size: 11px; }
        .banner h2 { margin: 0 0 4px; font-size: 18px; }
        .banner .lead { margin: 0 0 10px; color: var(--muted); }
        .issues { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
        .issues li { display: flex; gap: 8px; align-items: flex-start; min-width: 0; overflow-wrap: anywhere; }
        .issues .area { color: var(--muted); font-size: 12px; min-width: 84px; padding-top: 1px; }
        @@media (max-width: 560px) { .banner { grid-template-columns: minmax(0, 1fr); justify-items: start; } }

        /* Level colours */
        .ok { --c: var(--ok); } .info { --c: var(--info); } .warn { --c: var(--warn); } .crit { --c: var(--crit); } .muted { --c: var(--muted); }
        .tone { color: var(--c); }
        .pill { display: inline-flex; align-items: center; gap: 6px; padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 500; white-space: nowrap;
                color: var(--c); background: color-mix(in srgb, var(--c) 13%, transparent); }
        .pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

        /* KPI tiles */
        .kpis { display: grid; gap: 16px; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 16px; }
        @@media (max-width: 960px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @@media (max-width: 520px) { .kpis { grid-template-columns: minmax(0, 1fr); } }
        .kpi .label { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; }
        .kpi .value { font-size: 28px; font-weight: 650; margin: 6px 0 2px; letter-spacing: -.02em; }
        .kpi .hint { color: var(--muted); font-size: 12px; }
        .bar { height: 6px; border-radius: 99px; background: var(--track); overflow: hidden; margin-top: 10px; }
        .bar > span { display: block; height: 100%; border-radius: inherit; background: var(--c); }

        /* Key/value + tables */
        .kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 7px 16px; margin: 0; }
        .kv dt { color: var(--muted); }
        .kv dd { margin: 0; overflow-wrap: anywhere; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; font-weight: 500; color: var(--muted); font-size: 12px; padding: 0 8px 8px 0; }
        td { padding: 7px 8px 7px 0; border-top: 1px solid var(--border); vertical-align: middle; }
        td.num, th.num { text-align: right; padding-right: 0; white-space: nowrap; }
        .scroll { overflow-x: auto; }
        .dim { color: var(--muted); }
        .small { font-size: 12px; }

        .chips { display: flex; flex-wrap: wrap; gap: 6px; }
        .chip { font-family: var(--mono); font-size: 12px; padding: 3px 8px; border-radius: 7px; background: var(--surface-2); border: 1px solid var(--border); }
        .chip.local { color: var(--muted); border-style: dashed; }

        .empty { color: var(--muted); font-size: 13px; }
        .foot { margin-top: 28px; text-align: center; color: var(--muted); font-size: 12px; }
    </style>
</head>
<body>
    @RenderBody()
    @RenderSection("Scripts", required: false)
</body>
</html>
