@model SampleBlankSite.Models.SystemInfoViewModel
@{
    ViewData["Title"] = "System Information";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />
</head>
<body class="bg-gray-100">
    <div class="container mx-auto px-4 py-8">
        <header class="mb-8">
            <h1 class="text-3xl font-bold text-center text-blue-600">
                <i class="fas fa-server mr-2"></i>System Information Dashboard
            </h1>
            <p class="text-center text-gray-600 mt-2">Current status of this web server</p>
        </header>

        <div class="grid grid-cols-1 gap-6">
            <!-- Basic Info -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800">
                    <i class="fas fa-info-circle mr-2 text-blue-500"></i>Basic Information
                </h2>
                <div class="space-y-3">
                    <div class="flex items-start">
                        <div class="w-8 text-blue-500"><i class="fas fa-network-wired"></i></div>
                        <div>
                            <p class="font-medium">IP Address</p>
                            <p class="text-gray-600">@Model.IpAddress</p>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <div class="w-8 text-blue-500"><i class="fas fa-folder-open"></i></div>
                        <div>
                            <p class="font-medium">Website Directory</p>
                            <p class="text-gray-600 break-all">@Model.WebsiteDirectory</p>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <div class="w-8 text-blue-500"><i class="fas fa-globe"></i></div>
                        <div>
                            <p class="font-medium">Website IP Address</p>
                            <p class="text-gray-600">@Model.WebsiteIpAddress</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- .NET Info -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800">
                    <i class="fab fa-microsoft mr-2 text-purple-600"></i>.NET SDK Versions
                </h2>
                <div class="border rounded-lg overflow-hidden">
                    <div class="max-h-60 overflow-y-auto">
                        @if (Model.DotNetSdkVersions != null && Model.DotNetSdkVersions.Any())
                        {
                            <ul class="divide-y">
                                @foreach (var version in Model.DotNetSdkVersions)
                                {
                                    <li class="p-3 hover:bg-gray-50">
                                        <i class="fas fa-code-branch mr-2 text-purple-500"></i>@version
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="p-3 text-gray-500">No .NET SDK versions found</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Web Server Info -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800">
                    <i class="fas fa-server mr-2 text-green-600"></i>Web Server
                </h2>
                <div class="space-y-4">
                    <div class="border rounded-lg p-4">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center">
                                <i class="fas fa-server mr-2 text-green-500"></i>
                                <span class="font-medium">Nginx</span>
                            </div>
                            <span class="px-2 py-1 text-xs rounded-full @(Model.NginxStatus.IsRunning ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                @(Model.NginxStatus.IsRunning ? "Running" : "Stopped")
                            </span>
                        </div>
                        <div class="text-sm text-gray-600">
                            <p><span class="font-medium">Installed:</span> @(Model.NginxStatus.IsInstalled ? "Yes" : "No")</p>
                            <p><span class="font-medium">Version:</span> @Model.NginxStatus.Version</p>
                            <p><span class="font-medium">Status:</span> @Model.NginxStatus.ConnectionStatus</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Database Info -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800">
                    <i class="fas fa-database mr-2 text-yellow-600"></i>Databases
                </h2>
                <div class="space-y-4">
                    <!-- MongoDB -->
                    <div class="border rounded-lg p-4">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center">
                                <i class="fas fa-database mr-2 text-green-600"></i>
                                <span class="font-medium">MongoDB</span>
                            </div>
                            <span class="px-2 py-1 text-xs rounded-full @(Model.MongoDbInfo.IsRunning ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                @(Model.MongoDbInfo.IsRunning ? "Running" : "Stopped")
                            </span>
                        </div>
                        <div class="text-sm text-gray-600">
                            <p><span class="font-medium">Installed:</span> @(Model.MongoDbInfo.IsInstalled ? "Yes" : "No")</p>
                            <p><span class="font-medium">Version:</span> @Model.MongoDbInfo.Version</p>
                            <p><span class="font-medium">Connection:</span> @Model.MongoDbInfo.ConnectionStatus</p>
                        </div>
                    </div>

                    <!-- MySQL -->
                    <div class="border rounded-lg p-4">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center">
                                <i class="fas fa-database mr-2 text-blue-600"></i>
                                <span class="font-medium">MySQL</span>
                            </div>
                            <span class="px-2 py-1 text-xs rounded-full @(Model.MySqlInfo.IsRunning ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                @(Model.MySqlInfo.IsRunning ? "Running" : "Stopped")
                            </span>
                        </div>
                        <div class="text-sm text-gray-600">
                            <p><span class="font-medium">Installed:</span> @(Model.MySqlInfo.IsInstalled ? "Yes" : "No")</p>
                            <p><span class="font-medium">Version:</span> @Model.MySqlInfo.Version</p>
                            <p><span class="font-medium">Connection:</span> @Model.MySqlInfo.ConnectionStatus</p>
                        </div>
                    </div>

                    <!-- PostgreSQL -->
                    <div class="border rounded-lg p-4">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center">
                                <i class="fas fa-database mr-2 text-blue-800"></i>
                                <span class="font-medium">PostgreSQL</span>
                            </div>
                            <span class="px-2 py-1 text-xs rounded-full @(Model.PostgreSqlInfo.IsRunning ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                @(Model.PostgreSqlInfo.IsRunning ? "Running" : "Stopped")
                            </span>
                        </div>
                        <div class="text-sm text-gray-600">
                            <p><span class="font-medium">Installed:</span> @(Model.PostgreSqlInfo.IsInstalled ? "Yes" : "No")</p>
                            <p><span class="font-medium">Version:</span> @Model.PostgreSqlInfo.Version</p>
                            <p><span class="font-medium">Connection:</span> @Model.PostgreSqlInfo.ConnectionStatus</p>
                        </div>
                    </div>

                    <!-- SQL Server -->
                    <div class="border rounded-lg p-4">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center">
                                <i class="fas fa-database mr-2 text-red-600"></i>
                                <span class="font-medium">SQL Server</span>
                            </div>
                            <span class="px-2 py-1 text-xs rounded-full @(Model.SqlServerInfo.IsRunning ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                @(Model.SqlServerInfo.IsRunning ? "Running" : "Stopped")
                            </span>
                        </div>
                        <div class="text-sm text-gray-600">
                            <p><span class="font-medium">Installed:</span> @(Model.SqlServerInfo.IsInstalled ? "Yes" : "No")</p>
                            <p><span class="font-medium">Version:</span> @Model.SqlServerInfo.Version</p>
                            <p><span class="font-medium">Connection:</span> @Model.SqlServerInfo.ConnectionStatus</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Docker Info -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800">
                    <i class="fab fa-docker mr-2 text-blue-700"></i>Docker
                </h2>
                <div class="border rounded-lg p-4">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center">
                            <i class="fab fa-docker mr-2 text-blue-600"></i>
                            <span class="font-medium">Docker</span>
                        </div>
                        <span class="px-2 py-1 text-xs rounded-full @(Model.DockerInfo.IsRunning ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                            @(Model.DockerInfo.IsRunning ? "Running" : "Stopped")
                        </span>
                    </div>
                    <div class="text-sm text-gray-600">
                        <p><span class="font-medium">Installed:</span> @(Model.DockerInfo.IsInstalled ? "Yes" : "No")</p>
                        <p><span class="font-medium">Version:</span> @Model.DockerInfo.Version</p>
                        <p><span class="font-medium">Status:</span> @Model.DockerInfo.ConnectionStatus</p>
                    </div>
                </div>
            </div>

            <!-- Open Ports -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800">
                    <i class="fas fa-plug mr-2 text-indigo-600"></i>Open Ports
                </h2>
                <div class="border rounded-lg overflow-hidden">
                    <div class="max-h-60 overflow-y-auto">
                        @if (Model.OpenPorts != null && Model.OpenPorts.Any())
                        {
                            <div class="grid grid-cols-4 gap-2 p-3">
                                @foreach (var port in Model.OpenPorts)
                                {
                                    <div class="bg-indigo-100 text-indigo-800 rounded px-3 py-1 text-center">
                                        @port
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="p-3 text-gray-500">No open ports found</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <footer class="mt-8 text-center text-gray-600 text-sm">
            <p>Last updated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
        </footer>
    </div>
</body>
</html>